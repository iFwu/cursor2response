{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/runtime",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "core/**/*.ts",
    "sidecar/**/*.ts",
    "scripts/validate-api-fallback.ts",
    "scripts/validate-responses-phases.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/test-helpers.ts"
  ]
}
