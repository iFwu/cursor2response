# Required internal token. Generate with: openssl rand -hex 32
CURSOR_SDK_BRIDGE_TOKEN=

# Optional default provider key. Otherwise clients supply their own Cursor key.
CURSOR_API_KEY=
API_PORT=6718
VIEWER_PORT=8100

# Optional HTTP(S) proxy for Cursor SDK traffic. Docker users should use a
# proxy address reachable from the container, such as host.docker.internal.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,0.0.0.0,::1,bridge,api,viewer
NODE_USE_ENV_PROXY=1

# Enable when the proxy cannot carry HTTP/2 bidirectional streams.
CURSOR_SDK_USE_HTTP1_FOR_AGENT=

# Optional trusted CA bundle path. In Docker this must be a mounted container path.
NODE_EXTRA_CA_CERTS=

# Optional context-overflow route, enabled by selecting model grok-hybrid.
CURSOR2RESPONSE_GROK_HYBRID_FALLBACK_BASE_URL=
CURSOR2RESPONSE_GROK_HYBRID_FALLBACK_API_KEY=
CURSOR2RESPONSE_GROK_HYBRID_FALLBACK_MODEL=
